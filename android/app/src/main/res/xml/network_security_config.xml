<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">corsproxy.io</domain>
        <domain includeSubdomains="true">allorigins.win</domain>
        <domain includeSubdomains="true">herokuapp.com</domain>
        <domain includeSubdomains="true">maps.app.goo.gl</domain>
        <domain includeSubdomains="true">goo.gl</domain>
        <domain includeSubdomains="true">google.com</domain>
    </domain-config>
</network-security-config>



